# ========================================================
# KrishiSalah - Environment Configuration Template
# ========================================================
# NOTE: Never store real secrets or API keys in this file.
# Copy this file to .env for local development or configure in your deployment dashboard.

# Google Gemini API Key (Required ONLY if running an optional backend proxy)
# Do NOT prefix with VITE_ to prevent leaking the secret to browser client bundles!
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Optional custom backend URL for AI Assistant proxy (default is empty for built-in offline smart advisor)
# VITE_AI_BACKEND_URL=https://your-backend-api.example.com/api/chat

# Open-Meteo Weather API requires NO API KEY (Completely free for non-commercial & public use)
